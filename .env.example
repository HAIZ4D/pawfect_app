# ============================================================
# Pawfect App - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git - it is gitignored.
# ============================================================

# --- Google Gemini AI ---
# Get your key at: https://makersuite.google.com/app/apikey
# Jangan lupa create your own .env file sendiri hihihi
# Then, masukkan kamu punya API Key Sendiri dalam .env hihihi
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Firebase ---
# firebase_options.dart is auto-generated by FlutterFire CLI.
# Run: flutterfire configure
# It is gitignored - never commit it.
# Also gitignored: android/app/google-services.json, ios/GoogleService-Info.plist

# --- Gemini reasoning depth (optional) ---
# Gemini 3.x bills thinking tokens as output and spends them from the
# same maxOutputTokens budget as the answer. Defaults to "low", which
# measured identical conclusions at roughly half the tokens.
# Set to "default" to hand the decision back to the model.
GEMINI_THINKING_LEVEL=low
